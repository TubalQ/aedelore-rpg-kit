# app.env  (chmod 600) - real values live only on the host, never in git.
DATABASE_URL=postgres://<user>:<password>@<db-host>:5432/<database>

AUTH_SECRET=<openssl rand -base64 32>
AUTH_URL=https://<your-domain>
NEXTAUTH_URL=https://<your-domain>
AUTH_TRUST_HOST=true

# Auth = any OIDC provider. The AUTH_KEYCLOAK_* names are historical; the values
# point at whatever confidential OIDC client you create (PKCE recommended).
AUTH_KEYCLOAK_ID=<oidc-client-id>
AUTH_KEYCLOAK_SECRET=<oidc-client-secret>
AUTH_KEYCLOAK_ISSUER=https://<your-auth-issuer>

# OIDC client id used by the MCP server (the app's bearer-auth accepts its aud/azp).
MCP_CLIENT_ID=<mcp-oidc-client-id>

# Which game system to load (a directory under src/systems/).
NEXT_PUBLIC_ACTIVE_SYSTEM=example

NODE_ENV=production
