# mcp.env  (chmod 600) - real values live only on the host, never in git.

# API_URL reaches the app via pod loopback (app + mcp share the pod netns).
# The MCP server reads game data live from the app at API_URL/api/game-data.
API_URL=http://127.0.0.1:3002
PUBLIC_URL=https://<your-domain>
PORT=3100
LOG_LEVEL=info
ALLOWED_REDIRECT_HOSTS=claude.ai,chatgpt.com

# Auth = any OIDC provider. Confidential client used by the MCP server.
KEYCLOAK_ISSUER=https://<your-auth-issuer>
KEYCLOAK_CLIENT_ID=<mcp-oidc-client-id>
KEYCLOAK_CLIENT_SECRET=<oidc-client-secret>
