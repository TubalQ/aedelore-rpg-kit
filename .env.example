# Aedelore RPG Kit - environment.
# Copy to .env and fill in. Never commit .env with real secrets.

# ─── Database (the bundled Postgres in compose.yaml) ───────────────────────────
# POSTGRES_PASSWORD is required. DATABASE_URL must use the same password and the
# service name `db` as host.
POSTGRES_USER=rpgkit
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=rpgkit
DATABASE_URL=postgres://rpgkit:change-me-please@db:5432/rpgkit

# ─── App ───────────────────────────────────────────────────────────────────────
# Which game system to load (a directory under src/systems/). `example` ships
# with the kit; copy it to build your own - see docs/BUILD-YOUR-OWN-SYSTEM.md.
NEXT_PUBLIC_ACTIVE_SYSTEM=example

APP_PORT=3002
AUTH_URL=http://localhost:3002
NEXTAUTH_URL=http://localhost:3002
AUTH_TRUST_HOST=true
# Generate with:  openssl rand -base64 32
AUTH_SECRET=change-me-generate-a-random-secret

# ─── Authentication ────────────────────────────────────────────────────────────
# Email/password sign-in is the default for self-hosting; the first account to
# register becomes the admin. (Wired up in the auth step.)
#
# Optional: use an external OIDC provider instead / as well. Create a confidential
# client and set:
# AUTH_KEYCLOAK_ID=<oidc-client-id>
# AUTH_KEYCLOAK_SECRET=<oidc-client-secret>
# AUTH_KEYCLOAK_ISSUER=https://<your-auth-issuer>
# MCP_CLIENT_ID=<mcp-oidc-client-id>

# ─── MCP server (optional: docker compose --profile mcp up) ────────────────────
MCP_PORT=3100
# API_URL=http://127.0.0.1:3002
# PUBLIC_URL=http://localhost:3100
