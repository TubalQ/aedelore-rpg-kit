# Aedelore RPG Kit - environment.
# Copy to .env and fill in. Never commit .env with real secrets.

# ─── Database (the bundled Postgres in compose.yaml) ───────────────────────────
# POSTGRES_PASSWORD is required. DATABASE_URL must use the same password and the
# service name `db` as host.
POSTGRES_USER=rpgkit
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=rpgkit
DATABASE_URL=postgres://rpgkit:change-me-please@db:5432/rpgkit

# ─── App ───────────────────────────────────────────────────────────────────────
# Which game system to load (a directory under src/systems/). `example` ships
# with the kit; copy it to build your own - see docs/BUILD-YOUR-OWN-SYSTEM.md.
NEXT_PUBLIC_ACTIVE_SYSTEM=example

APP_PORT=3002
AUTH_URL=http://localhost:3002
NEXTAUTH_URL=http://localhost:3002
AUTH_TRUST_HOST=true
# Generate with:  openssl rand -base64 32
AUTH_SECRET=change-me-generate-a-random-secret

# ─── Authentication ────────────────────────────────────────────────────────────
# Email and password: register at /register; the first account becomes the
# admin. A forgotten password is reset by the operator (README, Accounts).
AUTH_PASSWORD_ENABLED=true

# Optional single sign-on through any OIDC provider (Keycloak, Authentik,
# Zitadel, Pocket ID, ...): create a confidential client with the redirect URI
# <AUTH_URL>/api/auth/callback/keycloak and set these (the KEYCLOAK names are
# historical). The MCP server always needs OIDC.
# AUTH_KEYCLOAK_ID=<oidc-client-id>
# AUTH_KEYCLOAK_SECRET=<oidc-client-secret>
# AUTH_KEYCLOAK_ISSUER=https://<your-auth-issuer>

# ─── MCP server (optional: docker compose --profile mcp up) ────────────────────
# Needs its own confidential OIDC client with the redirect URI
# <PUBLIC_URL>/mcp/oauth/oidc-callback. Uncomment and fill in to enable.
MCP_PORT=3100
# KEYCLOAK_ISSUER=https://<your-auth-issuer>
# KEYCLOAK_CLIENT_ID=<mcp-oidc-client-id>
# KEYCLOAK_CLIENT_SECRET=<mcp-oidc-client-secret>
# PUBLIC_URL=https://<your-domain>
# API_URL=http://127.0.0.1:3002
