# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc / os / editor
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/
*.swp
*~

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files & secrets (real values never committed - only *.example)
.env*
!.env.example
env/*.env
!env/*.env.example
*.key
*.p12
*.pfx
*.p8

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# User-uploaded media (persisted via a volume at runtime)
/public/uploads/*
!/public/uploads/.gitkeep

# MCP game-data is generated at runtime (init service) into a volume,
# per the active system. Not committed.
/mcp/game-data/*.json
